# ==============================================================================
# Taraba State e-Procurement Platform - Environment Configuration (.env)
# Note: Keep secret keys and production passwords out of source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Application Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-1234567890abcdef
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,procurement.taraba.gov.ng
DJANGO_DEBUG=1

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Set USE_POSTGRES=1 to use PostgreSQL (via PG* vars or DATABASE_URL).
# Set USE_POSTGRES=0 to use SQLite for lightweight local development.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgres://taraba_app:password@localhost:5432/taraba_procure?sslmode=require
USE_POSTGRES=0
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=taraba_procure
PGUSER=taraba_app
PGPASSWORD=changeme
SQLITE_PATH=db.sqlite3

# ------------------------------------------------------------------------------
# 3. Security, CSRF & HTTPS Settings
# ------------------------------------------------------------------------------
# Set TARABA_HTTPS=1 in production to enforce HSTS preload & secure cookies
TARABA_HTTPS=0
CSRF_TRUSTED_ORIGINS=https://procurement.taraba.gov.ng
CSP_REPORT_ONLY=0
COLLECTORS_ENDPOINT=

# ------------------------------------------------------------------------------
# 4. Platform Identity & Support Contact Details
# ------------------------------------------------------------------------------
PLATFORM_NAME=Taraba State Procurement Transparency Portal
PLATFORM_ABBREV=TAR
CONTACT_PHONE=+234 800 000 0000
CONTACT_EMAIL=bpp@tr.gov.ng

# ------------------------------------------------------------------------------
# 5. Procurement, Compliance & Upload Thresholds
# ------------------------------------------------------------------------------
PENCOM_MIN_EMPLOYEES=3
ITF_MIN_EMPLOYEES=5
MAX_UPLOAD_BYTES=5242880
SEALED_BID_DEMO=1

# ------------------------------------------------------------------------------
# 6. Cryptographic Keys, OTP & Messaging Providers
# ------------------------------------------------------------------------------
# OTP_SIGNING_KEY and RECEIPT_SIGNING_KEY fallback to DJANGO_SECRET_KEY if empty
OTP_SIGNING_KEY=
RECEIPT_SIGNING_KEY=
SMS_PROVIDER=console
SMS_SENDER_ID=TAR-BPP
WHATSAPP_PROVIDER=none

# ------------------------------------------------------------------------------
# 7. Logging & Build Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
RUN_DB_MIGRATIONS=1
