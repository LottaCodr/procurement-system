# ==============================================================================
# Taraba State e-Procurement Platform - Environment Template (.env.example)
# Note what is *state-owned*: the domain, the cloud accounts, the git repository.
# Copy this file to .env and adjust configuration for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Application Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(50))">
DJANGO_ALLOWED_HOSTS=procurement.taraba.gov.ng,localhost,127.0.0.1
DJANGO_DEBUG=0

# ------------------------------------------------------------------------------
# 2. Database Configuration
# Set USE_POSTGRES=1 to use PostgreSQL (via PG* vars or DATABASE_URL).
# Managed providers (Neon, Supabase, Vercel Postgres) use DATABASE_URL.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgres://taraba_app:password@<host>:5432/taraba_procure?sslmode=require
USE_POSTGRES=1
PGHOST=<state-owned managed postgres host>
PGPORT=5432
PGDATABASE=taraba_procure
PGUSER=taraba_app
PGPASSWORD=<rotated quarterly, held by state, NOT by the vendor>
SQLITE_PATH=db.sqlite3

# ------------------------------------------------------------------------------
# 3. Security, CSRF & HTTPS Settings
# ------------------------------------------------------------------------------
TARABA_HTTPS=1
CSRF_TRUSTED_ORIGINS=https://procurement.taraba.gov.ng
CSP_REPORT_ONLY=0
COLLECTORS_ENDPOINT=

# ------------------------------------------------------------------------------
# 4. Platform Identity & Support Contact Details
# ------------------------------------------------------------------------------
PLATFORM_NAME=Taraba State Procurement Transparency Portal
PLATFORM_ABBREV=TAR
CONTACT_PHONE=+234 800 000 0000   # release checklist must call this number
CONTACT_EMAIL=bpp@tr.gov.ng       # must have a real MX and a monitored mailbox

# ------------------------------------------------------------------------------
# 5. Procurement, Compliance & Upload Thresholds
# ------------------------------------------------------------------------------
PENCOM_MIN_EMPLOYEES=3
ITF_MIN_EMPLOYEES=5
MAX_UPLOAD_BYTES=5242880
SEALED_BID_DEMO=1   # Set to 0 in production once sealed key ceremony is rehearsed

# ------------------------------------------------------------------------------
# 6. Cryptographic Keys, OTP & Messaging Providers
# ------------------------------------------------------------------------------
OTP_SIGNING_KEY=<generate separate secret or leave blank to default to DJANGO_SECRET_KEY>
RECEIPT_SIGNING_KEY=<generate separate secret or leave blank to default to DJANGO_SECRET_KEY>
SMS_PROVIDER=console   # Options: console | africastalking | termii
SMS_SENDER_ID=TAR-BPP
WHATSAPP_PROVIDER=none

# ------------------------------------------------------------------------------
# 7. Logging & Build Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
RUN_DB_MIGRATIONS=1
